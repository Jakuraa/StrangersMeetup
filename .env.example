# StrangersMeetup Configuration Template
# Copy this file to .env for local testing or enter secrets in your hosting dashboard

# Application Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ENABLE_LIVE_PAYMENTS=false

# Telegram Bot API Credentials (Obtain from @BotFather on Telegram)
# Format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=StrangersMeetupBot

# Webhook Authentication Secret
# Must be 1-256 characters (a-z, A-Z, 0-9, _ and -)
# Telegram passes this in the 'X-Telegram-Bot-Api-Secret-Token' header
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_min_16_chars

# Private Telegram Channels (Must be negative integers with -100 prefix)
# The bot MUST be added as an Administrator to each channel with "Invite Users via Link" rights
TELEGRAM_INSIDER_CHANNEL_ID=-1000000000001
TELEGRAM_SOCIAL_PLUS_CHANNEL_ID=-1000000000002
TELEGRAM_VIP_CHANNEL_ID=-1000000000003

# Cryptographic Salt / Secret for payload signing
APP_SECRET=your_super_secret_internal_app_key_change_in_production

# Legal & Statutory Compliance
GRIEVANCE_EMAIL=grievance-officer@strangersmeetup.example.com
LEGAL_ENTITY_NAME=StrangersMeetup Operating Entity
SUPPORT_EMAIL=support@strangersmeetup.example.com
