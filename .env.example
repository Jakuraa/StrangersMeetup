# StrangersMeetup environment variables — NAMES ONLY. Set values in Vercel (Settings → Environment
# Variables) or a local, uncommitted .env. Never commit or paste real values.

# Core
DATABASE_URL=
SESSION_SECRET=
CRON_SECRET=
PUBLIC_SITE_URL=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Telegram Login (OpenID Connect) for website sign-in
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# true = use Telegram's test environment (sandbox Stars)
TELEGRAM_TEST_ENV=

# Private chats
TG_CHAT_ID_TIER_1=
TG_CHAT_ID_TIER_2=
TG_CHAT_ID_TIER_3=
TG_CHAT_ID_EVENTS=

# Payments
# Tickets are bought on SuperProfile (no card gateway keys here). ENABLE_LIVE_PAYMENTS only labels
# Telegram Stars membership payments as test/live.
ENABLE_LIVE_PAYMENTS=false

# SuperProfile notifications (tickets + memberships) via Zapier/Pabbly: shared secret sent as X-Webhook-Secret, 24+ chars
# Endpoint: POST /api/webhooks/superprofile
SUPERPROFILE_WEBHOOK_SECRET=

# Site
SOCIAL_PROOF_MIN=5
ADMIN_BOOTSTRAP_TELEGRAM_ID=
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=

# Database operations
# Vercel builds migrate only in Production. Set true on Preview ONLY if Preview has its own database.
MIGRATE_ON_PREVIEW=
# Allow `npm run seed:demo` against a non-local database (a dedicated preview DB only; never production).
SEED_ALLOW_REMOTE=
PG_POOL_MAX=

# Optional
DISABLE_WEB_ANALYTICS=

# Local development only (ignored on Vercel): DEV_LOGIN=true enables the /signin test personas
# (npm run seed:local) — only with a local DATABASE_URL and never in production. See docs/LOCAL_TESTING.md.
DEV_LOGIN=
PORT=
# Local runs only; the dev login refuses NODE_ENV=production.
NODE_ENV=
