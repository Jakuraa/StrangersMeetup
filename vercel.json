{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": { "fix/preview-recovery-audit": false }
  },
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/venue.html", "destination": "/list-your-venue", "permanent": true },
    { "source": "/venue", "destination": "/list-your-venue", "permanent": true },
    { "source": "/partner.html", "destination": "/partner-with-us", "permanent": true },
    { "source": "/partner", "destination": "/partner-with-us", "permanent": true },
    { "source": "/host.html", "destination": "/become-a-host", "permanent": true },
    { "source": "/host", "destination": "/become-a-host", "permanent": true },
    { "source": "/safety.html", "destination": "/trust-safety", "permanent": true },
    { "source": "/safety", "destination": "/trust-safety", "permanent": true },
    { "source": "/community.html", "destination": "/community-guidelines", "permanent": true },
    { "source": "/community", "destination": "/community-guidelines", "permanent": true },
    { "source": "/billing.html", "destination": "/refunds", "permanent": true },
    { "source": "/billing", "destination": "/refunds", "permanent": true },
    { "source": "/grievance.html", "destination": "/contact", "permanent": true },
    { "source": "/grievance", "destination": "/contact", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/api/webhook", "destination": "/api/telegram/webhook", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?__path=/$1" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "30 0 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://telegram.org https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://va.vercel-scripts.com; frame-src https://oauth.telegram.org; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self' https://oauth.telegram.org; object-src 'none'" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(css|js|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ]
}
