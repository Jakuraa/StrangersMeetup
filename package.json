{
  "name": "strangersmeetup",
  "version": "1.0.0",
  "description": "StrangersMeetup — social discovery meetups & trips across South India (21+)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/migrate.js --seed-demo",
    "db:reset:local": "node scripts/db-reset-local.js",
    "seed:local": "node scripts/seed-local.js",
    "vercel-build": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "node scripts/lint.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "mcp": "node mcp/server.js",
    "mcp:stdio": "node mcp/server.js --stdio"
  },
  "keywords": [
    "strangersmeetup",
    "meetups",
    "telegram"
  ],
  "author": "StrangersMeetup Team",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/functions": "^2.2.13",
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.23.1",
    "undici": "7.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
